{% extends 'base.html.twig' %}

{% block title %}Image du jour - NASA{% endblock %}

{% block body %}
    <div class="flex flex-col items-center gap-2 pt-2 pb-16">
        <h1 class="font-bold text-4xl">{{ title }}</h1>

        <div class="w-[60%]">
            <img class="rounded-xl" src="{{ url }}" alt="Image de test">
            <p class="underline">Date : {{ "now"|date("d/m/Y") }}</p>
            <p>{{ explanation }}</p>
        </div>
    </div>
{% endblock %}