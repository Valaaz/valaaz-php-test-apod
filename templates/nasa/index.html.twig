{% extends 'base.html.twig' %}

{% block title %}Image du jour - NASA{% endblock %}

{% block body %}
    <div class="flex flex-col items-center gap-2 pt-2 pb-16">
        <h1 class="font-bold text-4xl">{{ picture.title }}</h1>

        <div class="w-[60%]">
            <img class="rounded-xl" src="{{ picture.url }}" alt="{{ picture.title }}">
            <p class="underline">Date : {{ picture.date|date('d/m/Y') }}</p>
            <p>{{ picture.explanation }}</p>
        </div>
    </div>
{% endblock %}