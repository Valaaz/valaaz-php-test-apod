{% extends 'base.html.twig' %}

{% block title %}Image du jour - NASA{% endblock %}

{% block body %}
    <div class="container">
        <h1>{{ title }}</h1>

        <div class="card">
            <img src="{{ url }}" alt="Image de test">

            <div class="card-body">
                <p>Date : {{ "now"|date("d/m/Y") }}</p>
                <p>{{ explanation }}</p>
            </div>
        </div>
    </div>
{% endblock %}